<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Units - NCTverse</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            display: flex;
        }

        .content {
            margin-left: 250px;
            padding: 40px;
            width: 100%;
            box-sizing: border-box;
        }

        h1 { margin-top: 0; color: #333; }

        /* TOMBOL TAMBAH */
        .btn-add {
            background-color: #ccff00;
            color: #000;
            font-weight: bold;
            text-decoration: none;
            padding: 12px 25px;
            border-radius: 8px;
            display: inline-block;
            margin-bottom: 25px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: 0.3s;
        }
        .btn-add:hover { background-color: #b3e600; transform: translateY(-2px); }

        /* TABEL DATA */
        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        th, td {
            padding: 15px 20px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }

        th {
            background-color: #111;
            color: white;
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 1px;
        }

        tr:hover { background-color: #f9f9f9; }

        /* LOGO UNIT (Teks/Emoji) */
        .unit-logo {
            font-size: 1.5rem;
            background: #eee;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        /* TOMBOL AKSI */
        .btn {
            padding: 6px 12px;
            text-decoration: none;
            border-radius: 5px;
            font-size: 0.85rem;
            margin-right: 5px;
            font-weight: bold;
            color: white;
        }
        .btn-edit { background-color: #ffc107; color: #333; }
        .btn-delete { background-color: #dc3545; }
        
        .btn-edit:hover { background-color: #e0a800; }
        .btn-delete:hover { background-color: #c82333; }

    </style>
</head>
<body>

    <%- include('../partials/sidebar') %>

    <div class="content">
        <h1>🏢 Daftar Unit NCT</h1>
        <p style="color:#666; margin-bottom:20px;">Kelola unit/grup sub-unit yang ada di database.</p>

        <a href="/admin/units/add" class="btn-add">+ Tambah Unit Baru</a>

        <table>
            <thead>
                <tr>
                    <th style="width: 80px;">Logo</th>
                    <th>Nama Unit</th>
                    <th>Deskripsi</th>
                    <th style="width: 150px;">Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if(units.length === 0) { %>
                    <tr><td colspan="4" style="text-align:center; padding:30px;">Belum ada data unit.</td></tr>
                <% } %>

                <% units.forEach(u => { %>
                <tr>
                    <td>
                        <div class="unit-logo"><%= u.logo || '🎵' %></div>
                    </td>
                    <td><strong><%= u.nama_unit %></strong></td>
                    <td><%= u.deskripsi %></td>
                    <td>
                        <a href="/admin/units/edit/<%= u.id %>" class="btn btn-edit">Edit</a>
                        <a href="/admin/units/delete/<%= u.id %>" class="btn btn-delete" 
                           onclick="return confirm('Hapus unit <%= u.nama_unit %>?')">
                           Hapus
                        </a>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</body>
</html>
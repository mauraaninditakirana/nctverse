<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Units - NCTverse</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            display: flex;
        }

        .content {
            margin-left: 250px;
            padding: 40px;
            width: 100%;
            box-sizing: border-box; /* Agar padding tidak menambah lebar total */
            overflow-x: hidden; /* Mencegah scroll menyamping */
        }

        h1 { margin-top: 0; color: #333; }

        .btn-add {
            background-color: #ccff00;
            color: #000;
            font-weight: bold;
            text-decoration: none;
            padding: 12px 25px;
            border-radius: 8px;
            display: inline-block;
            margin-bottom: 25px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: 0.3s;
        }
        .btn-add:hover { background-color: #b3e600; transform: translateY(-2px); }

        /* --- PERBAIKAN TABEL --- */
        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            table-layout: fixed; /* PENTING: Agar lebar kolom terkunci */
        }

        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #eee;
            vertical-align: top; /* Teks dimulai dari atas */
            word-wrap: break-word; /* Teks panjang akan turun ke bawah */
        }

        th {
            background-color: #111;
            color: white;
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 1px;
        }

        /* Lebar Kolom Diatur Disini */
        th:nth-child(1) { width: 10%; } /* Logo */
        th:nth-child(2) { width: 15%; } /* Nama Unit */
        th:nth-child(3) { width: 55%; } /* Deskripsi (Paling Lebar) */
        th:nth-child(4) { width: 20%; } /* Aksi */

        tr:hover { background-color: #f9f9f9; }

        /* GAYA LOGO (GAMBAR) */
        .thumb {
            width: 60px;
            height: 60px;
            object-fit: cover; /* Agar gambar tidak gepeng */
            border-radius: 50%;
            border: 2px solid #ddd;
            background: #eee;
        }

        /* TOMBOL AKSI */
        .btn {
            padding: 6px 12px;
            text-decoration: none;
            border-radius: 5px;
            font-size: 0.85rem;
            margin-right: 5px;
            font-weight: bold;
            color: white;
            display: inline-block;
            margin-bottom: 5px;
        }
        .btn-edit { background-color: #ffc107; color: #333; }
        .btn-delete { background-color: #dc3545; }
        
        .btn-edit:hover { background-color: #e0a800; }
        .btn-delete:hover { background-color: #c82333; }

    </style>
</head>
<body>

    <%- include('../partials/sidebar') %>

    <div class="content">
        <h1>🏢 Daftar Unit NCT</h1>
        <p style="color:#666; margin-bottom:20px;">Kelola unit/grup sub-unit yang ada di database.</p>

        <a href="/admin/units/add" class="btn-add">+ Tambah Unit Baru</a>

        <table>
            <thead>
                <tr>
                    <th>Logo</th>
                    <th>Nama Unit</th>
                    <th>Deskripsi</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if(units.length === 0) { %>
                    <tr><td colspan="4" style="text-align:center; padding:30px;">Belum ada data unit.</td></tr>
                <% } %>

                <% units.forEach(u => { %>
                <tr>
                    <td>
                        <img src="/images/<%= u.logo || 'default.jpg' %>" class="thumb" alt="Logo">
                    </td>
                    <td>
                        <strong><%= u.nama_unit %></strong>
                    </td>
                    <td>
                        <div style="font-size: 0.95rem; line-height: 1.5; color: #444;">
                            <%= u.deskripsi %>
                        </div>
                    </td>
                    <td>
                        <a href="/admin/units/edit/<%= u.id %>" class="btn btn-edit">Edit</a>
                        <a href="/admin/units/delete/<%= u.id %>" class="btn btn-delete" 
                           onclick="return confirm('Hapus unit <%= u.nama_unit %>?')">
                           Hapus
                        </a>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</body>
</html>
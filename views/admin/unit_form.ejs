<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tambah Unit Baru</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --neon-green: #ccff00;
            --dark-bg: #0a0a0a;
            --card-bg: #161616;
            --text-main: #ffffff;
            --text-muted: #888888;
            --border-color: #333;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--dark-bg);
            color: var(--text-main);
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh; /* Full layar tanpa scroll */
            margin: 0;
            overflow: hidden;
        }

        .form-container {
            background: var(--card-bg);
            max-width: 600px; /* Lebar pas untuk form kecil */
            width: 90%;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            border: 1px solid var(--border-color);
            box-sizing: border-box;
        }

        h2 { 
            margin: 0 0 20px 0; 
            color: var(--text-main); 
            font-weight: 800; 
            text-align: center; 
            font-size: 1.5rem;
        }
        
        /* Grid Layout: Nama & Logo Sebelahan */
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .form-group { margin-bottom: 12px; }
        
        label { display: block; margin-bottom: 5px; font-weight: 600; color: var(--text-muted); font-size: 0.85rem; }
        
        input, textarea {
            width: 100%; padding: 10px; 
            border: 1px solid var(--border-color); 
            border-radius: 8px; 
            box-sizing: border-box;
            background: #000;
            color: #fff;
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            transition: 0.3s;
        }

        input:focus, textarea:focus {
            border-color: var(--neon-green);
            outline: none;
            box-shadow: 0 0 0 2px rgba(204, 255, 0, 0.1);
        }

        /* Buttons Container */
        .btn-group {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        button {
            background: var(--neon-green); color: #000; border: none; padding: 12px;
            font-weight: 800; cursor: pointer; border-radius: 8px; flex: 2;
            font-size: 0.9rem; text-transform: uppercase; transition: 0.3s;
        }
        button:hover { background: #fff; transform: translateY(-2px); }

        .back-btn { 
            display: block; text-align: center; background: #222; color: #fff; 
            text-decoration: none; padding: 12px; border-radius: 8px; flex: 1;
            font-size: 0.9rem; font-weight: 600; border: 1px solid #333;
        }
        .back-btn:hover { border-color: var(--text-muted); }

        /* Responsif HP */
        @media (max-width: 500px) {
            .form-row { grid-template-columns: 1fr; gap: 0; }
        }
    </style>
</head>
<body>

    <div class="form-container">
        <h2>Tambah Unit Baru</h2>
        
        <form action="/admin/units/add" method="POST">
            
            <div class="form-row">
                <div class="form-group">
                    <label>Nama Unit</label>
                    <input type="text" name="nama_unit" required placeholder="Contoh: NCT U">
                </div>
                <div class="form-group">
                    <label>Nama File Logo</label>
                    <input type="text" name="logo" placeholder="logo.jpg">
                </div>
            </div>

            <div class="form-group">
                <label>Deskripsi</label>
                <textarea name="deskripsi" rows="4" placeholder="Jelaskan tentang unit ini..." required></textarea>
            </div>

            <div class="btn-group">
                <a href="/admin/units" class="back-btn">Batal</a>
                <button type="submit">SIMPAN UNIT</button>
            </div>

        </form>
    </div>

</body>
</html>
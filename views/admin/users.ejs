<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola User API - NCTverse</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            display: flex;
        }

        /* KONTEN UTAMA */
        .content {
            margin-left: 250px; /* Memberi ruang untuk sidebar */
            padding: 40px;
            width: 100%;
            box-sizing: border-box;
        }

        h1 { margin-top: 0; color: #333; }

        /* TABEL DATA */
        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            margin-top: 25px;
        }

        th, td {
            padding: 15px 20px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }

        th {
            background-color: #111;
            color: white;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
        }

        tr:hover { background-color: #f9f9f9; }

        /* TOMBOL AKSI */
        .btn {
            display: inline-block;
            padding: 6px 12px;
            text-decoration: none;
            border-radius: 5px;
            font-size: 0.85rem;
            font-weight: bold;
            color: white;
            margin-right: 5px;
            transition: 0.3s;
        }

        .btn-edit {
            background-color: #ffc107; /* Orange/Kuning */
            color: #333;
        }
        .btn-edit:hover { background-color: #e0a800; }

        .btn-detail {
            background-color: #007bff; /* Biru */
        }
        .btn-detail:hover { background-color: #0056b3; }

    </style>
</head>
<body>

    <%- include('../partials/sidebar') %>

    <div class="content">
        <h1>👥 Daftar Developer (User API)</h1>
        <p style="color:#666;">Kelola akun developer yang terdaftar di sistem API NCTverse.</p>

        <table>
            <thead>
                <tr>
                    <th style="width: 50px;">ID</th>
                    <th>Nama Lengkap</th>
                    <th>Email</th>
                    <th>Aksi Admin</th>
                </tr>
            </thead>
            <tbody>
                <% if(users.length === 0) { %>
                    <tr><td colspan="4" style="text-align:center; padding:30px;">Belum ada user yang mendaftar.</td></tr>
                <% } %>

                <% users.forEach(u => { %>
                <tr>
                    <td>#<%= u.id %></td>
                    <td><strong><%= u.nama_lengkap %></strong></td>
                    <td><%= u.email %></td>
                    <td>
                        <a href="/admin/users/edit/<%= u.id %>" class="btn btn-edit">✏️ Edit Data</a>
                        
                        <a href="/admin/users/detail/<%= u.id %>" class="btn btn-detail">🔍 Lihat Key & History</a>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</body>
</html>
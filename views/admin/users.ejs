<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola User API - NCTverse</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            display: flex;
        }

        /* AREA KONTEN (Sebelah Kanan Sidebar) */
        .content {
            margin-left: 250px; /* Ruang untuk sidebar fixed */
            padding: 40px;
            width: 100%;
            box-sizing: border-box;
        }

        h1 { margin-top: 0; color: #333; }

        /* TABEL DATA */
        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            margin-top: 20px;
        }

        th, td {
            padding: 15px 20px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }

        th {
            background-color: #111;
            color: white;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
        }

        tr:hover { background-color: #f9f9f9; }

        /* STATUS BADGE */
        .status-badge {
            padding: 5px 10px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: bold;
            text-transform: uppercase;
        }
        .active { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .inactive { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }

        /* TOMBOL AKSI */
        .btn-detail {
            background-color: #007bff;
            color: white;
            padding: 8px 15px;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
            font-size: 0.9rem;
            transition: 0.3s;
        }
        .btn-detail:hover { background-color: #0056b3; }

    </style>
</head>
<body>

    <%- include('../partials/sidebar') %>

    <div class="content">
        <h1>👥 Daftar Pengguna API</h1>
        <p style="color:#666;">Berikut adalah developer yang mendaftar untuk menggunakan API NCTverse.</p>

        <table>
            <thead>
                <tr>
                    <th style="width: 50px;">ID</th>
                    <th>Nama Lengkap</th>
                    <th>Email</th>
                    <th>Status Kunci</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if(users.length === 0) { %>
                    <tr><td colspan="5" style="text-align:center; padding:30px;">Belum ada user yang mendaftar.</td></tr>
                <% } %>

                <% users.forEach(u => { %>
                <tr>
                    <td>#<%= u.id %></td>
                    <td><strong><%= u.nama_lengkap %></strong></td>
                    <td><%= u.email %></td>
                    <td>
                        <% if(u.status == 'active') { %>
                            <span class="status-badge active">✅ AKTIF</span>
                        <% } else { %>
                            <span class="status-badge inactive">🚫 NON-AKTIF</span>
                        <% } %>
                    </td>
                    <td>
                        <a href="/admin/users/detail/<%= u.id %>" class="btn-detail">🔍 Lihat Detail</a>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</body>
</html>
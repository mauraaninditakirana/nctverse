<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - NCTverse</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            display: flex; /* Layout Flexbox */
        }

        /* AREA KONTEN (Sebelah Kanan Sidebar) */
        .content {
            margin-left: 250px; /* Memberi ruang untuk sidebar fixed */
            padding: 40px;
            width: 100%;
            box-sizing: border-box;
        }

        h1 { margin-top: 0; color: #333; }

        /* GRID KARTU STATISTIK */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
            margin-top: 30px;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            display: flex;
            flex-direction: column;
            justify-content: center;
            border-left: 6px solid #ccc;
            transition: transform 0.3s;
        }

        .card:hover { transform: translateY(-5px); }

        .card h3 {
            margin: 0;
            color: #666;
            font-size: 1.1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .number {
            font-size: 3rem;
            font-weight: bold;
            color: #333;
            margin: 10px 0 0 0;
        }

        /* Warna Khusus Tiap Kartu */
        .card-members { border-left-color: #ccff00; }
        .card-units { border-left-color: #333; }
        .card-users { border-left-color: #007bff; }

    </style>
</head>
<body>

    <%- include('../partials/sidebar') %>

    <div class="content">
        <h1>👋 Dashboard Overview</h1>
        <p style="color:#666;">Selamat datang di panel admin NCT API Center.</p>

        <div class="stats-grid">
            
            <div class="card card-members">
                <h3>Total Members</h3>
                <p class="number"><%= totalMembers %></p>
            </div>

            <div class="card card-units">
                <h3>Total Units</h3>
                <p class="number"><%= totalUnits %></p>
            </div>

            <div class="card card-users">
                <h3>User API Terdaftar</h3>
                <p class="number"><%= totalUsers %></p>
            </div>

        </div>
    </div>

</body>
</html>
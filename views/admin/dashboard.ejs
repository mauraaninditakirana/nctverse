<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - NCTverse</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    
    <style>
        /* Variabel Global (Bisa dipakai di semua halaman) */
        :root {
            --neon-green: #ccff00;
            --dark-bg: #0a0a0a;
            --card-bg: #161616;
            --text-main: #ffffff;
            --text-muted: #888888;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--dark-bg);
            color: var(--text-main);
            margin: 0;
        }

        /* --- STYLE KONTEN DASHBOARD --- */
        .content {
            padding: 50px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .dashboard-header {
            text-align: center;
            margin-bottom: 50px;
        }

        h1 { 
            margin: 0; 
            font-weight: 800; 
            font-size: 3rem; 
            letter-spacing: -1px; 
            color: var(--text-main);
        }

        .welcome-text { color: var(--text-muted); margin-top: 10px; font-size: 1.1rem; }

        /* GRID KARTU */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .card {
            background: var(--card-bg);
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            display: flex;
            flex-direction: column;
            align-items: center;
            border: 1px solid #333;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            text-align: center;
        }

        .card:hover { 
            transform: translateY(-10px); 
            border-color: var(--neon-green);
            box-shadow: 0 15px 50px rgba(204, 255, 0, 0.15);
        }

        .card h3 {
            margin: 0; color: var(--text-muted); font-size: 0.95rem;
            text-transform: uppercase; letter-spacing: 2px; font-weight: 600;
        }

        .number {
            font-size: 5rem;
            font-weight: 800; 
            margin: 10px 0 0 0; 
            line-height: 1;
            /* Efek Gradient pada Angka */
            background: linear-gradient(180deg, #fff, #666);
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent;
        }

        @media (max-width: 768px) {
            .content { padding: 30px 20px; }
            h1 { font-size: 2rem; }
        }
    </style>
</head>
<body>

    <%- include('../partials/navbar') %>

    <div class="content">
        <div class="dashboard-header">
            <h1>ADMIN DASHBOARD</h1>
            <p class="welcome-text">Selamat datang, Administrator <strong>NCT API Center</strong>! 🚀</p>
        </div>

        <div class="stats-grid">
            <div class="card">
                <h3>Total Members</h3>
                <p class="number"><%= totalMembers %></p>
            </div>

            <div class="card">
                <h3>Total Units</h3>
                <p class="number"><%= totalUnits %></p>
            </div>

            <div class="card">
                <h3>User API Terdaftar</h3>
                <p class="number"><%= totalUsers %></p>
            </div>
        </div>
    </div>

</body>
</html>
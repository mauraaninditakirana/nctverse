<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Kelola Lagu - <%= album.judul %></title>
    <style>
        body { font-family: sans-serif; background: #f4f4f4; padding: 40px; }
        .container { max-width: 800px; margin: 0 auto; background: white; padding: 30px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
        h2 { margin-top: 0; color: #111; border-bottom: 2px solid #ccff00; padding-bottom: 10px; display: inline-block; }
        
        /* Form Tambah Lagu (Simple di atas) */
        .add-form { background: #eee; padding: 20px; border-radius: 8px; margin-bottom: 30px; display: flex; gap: 10px; align-items: center; }
        input[type="text"] { flex: 1; padding: 12px; border: 1px solid #ccc; border-radius: 5px; }
        button { background: #ccff00; color: #000; border: none; padding: 12px 20px; font-weight: bold; cursor: pointer; border-radius: 5px; }
        button:hover { background: #b3e600; }

        /* List Lagu */
        ul { list-style: none; padding: 0; }
        li { 
            background: #fff; border-bottom: 1px solid #eee; padding: 15px; 
            display: flex; justify-content: space-between; align-items: center; font-size: 1.1rem;
        }
        li:hover { background: #fafafa; }
        .num { font-weight: bold; color: #888; margin-right: 15px; width: 30px; }
        .delete-btn { color: red; text-decoration: none; font-size: 0.9rem; border: 1px solid red; padding: 5px 10px; border-radius: 5px; }
        .delete-btn:hover { background: red; color: white; }

        .back { display: inline-block; margin-top: 20px; color: #666; text-decoration: none; }
    </style>
</head>
<body>

    <div class="container">
        <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 20px;">
            <img src="/images/<%= album.cover || 'default_album.jpg' %>" style="width: 80px; height: 80px; object-fit: cover; border-radius: 10px;">
            <div>
                <small>Kelola Lagu untuk Album:</small>
                <h1 style="margin: 5px 0;"><%= album.judul %></h1>
            </div>
        </div>

        <form action="/admin/albums/<%= album.id %>/songs/add" method="POST" class="add-form">
            <input type="text" name="judul_lagu" placeholder="Ketik Judul Lagu Baru..." required autofocus>
            <button type="submit">➕ TAMBAH</button>
        </form>

        <h3>📜 Daftar Tracks (<%= songs.length %>)</h3>
        <ul>
            <% if(songs.length === 0) { %>
                <p style="color:#888; font-style: italic;">Belum ada lagu di album ini.</p>
            <% } %>

            <% songs.forEach((song, index) => { %>
                <li>
                    <div>
                        <span class="num"><%= index + 1 %>.</span>
                        <%= song.judul_lagu %>
                    </div>
                    <a href="/admin/songs/delete/<%= song.id %>/<%= album.id %>" class="delete-btn" onclick="return confirm('Hapus lagu ini?')">Hapus</a>
                </li>
            <% }) %>
        </ul>

        <a href="/admin/albums" class="back">← Kembali ke Daftar Album</a>
    </div>

</body>
</html>
<!DOCTYPE html>
<html>
<head>
    <title>Detail User - <%= user.nama_lengkap %></title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background: #f4f4f4; padding: 20px; }
        .card {
            background: white; max-width: 600px; margin: 0 auto;
            padding: 30px; border-radius: 10px; box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }
        h2 { margin-top: 0; color: #333; border-bottom: 2px solid #ccff00; padding-bottom: 10px; display: inline-block; }
        
        .row { margin-bottom: 15px; border-bottom: 1px solid #eee; padding-bottom: 10px; }
        .label { font-weight: bold; color: #555; display: block; margin-bottom: 5px; }
        .value { font-size: 1.1rem; color: #000; }
        
        .api-box {
            background: #111; color: #ccff00; padding: 15px; font-family: monospace;
            border-radius: 5px; word-break: break-all; margin-top: 5px;
        }

        .btn-toggle {
            display: block; width: 100%; text-align: center; padding: 15px;
            margin-top: 20px; text-decoration: none; font-weight: bold; font-size: 1.1rem;
            border-radius: 5px; transition: 0.3s;
        }
        .bg-red { background: #dc3545; color: white; }
        .bg-green { background: #28a745; color: white; }
        .bg-red:hover { background: #c82333; }
        .bg-green:hover { background: #218838; }

        .back-link { display: inline-block; margin-bottom: 20px; text-decoration: none; color: #333; }
    </style>
</head>
<body>

    <a href="/admin/users" class="back-link">← Kembali ke Daftar User</a>

    <div class="card">
        <h2>👤 Detail Pengguna</h2>

        <div class="row">
            <span class="label">Nama Lengkap:</span>
            <span class="value"><%= user.nama_lengkap %></span>
        </div>

        <div class="row">
            <span class="label">Email:</span>
            <span class="value"><%= user.email %></span>
        </div>

        <div class="row">
            <span class="label">Password (Database):</span>
            <span class="value" style="font-family: monospace; background: #eee; padding: 2px 5px;"><%= user.password %></span>
        </div>

        <div class="row">
            <span class="label">Waktu Bergabung:</span>
            <span class="value"><%= user.created_at %></span>
        </div>

        <div class="row" style="border:none;">
            <span class="label">🔑 API KEY USER:</span>
            <% if (user.api_key) { %>
                <div class="api-box"><%= user.api_key %></div>
            <% } else { %>
                <span style="color:red;">User belum generate API Key.</span>
            <% } %>
        </div>

        <hr>

        <div style="text-align: center;">
            <p>Status Saat Ini: 
                <strong style="font-size: 1.2rem; color: <%= user.status=='active'?'green':'red' %>">
                    <%= user.status.toUpperCase() %>
                </strong>
            </p>

            <% if (user.status == 'active') { %>
                <a href="/admin/users/toggle/<%= user.id %>/active" class="btn-toggle bg-red">
                    ⛔ NON-AKTIFKAN / STOP API
                </a>
                <p style="color: #666; font-size: 0.9rem; margin-top: 5px;">User tidak akan bisa mengambil data jika dinonaktifkan.</p>
            <% } else { %>
                <a href="/admin/users/toggle/<%= user.id %>/inactive" class="btn-toggle bg-green">
                    ✅ AKTIFKAN KEMBALI
                </a>
            <% } %>
        </div>

    </div>

</body>
</html>
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail User - NCTverse</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --neon-green: #ccff00;
            --dark-bg: #0a0a0a;
            --card-bg: #161616;
            --text-main: #ffffff;
            --text-muted: #888888;
            --border-color: #333;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--dark-bg);
            color: var(--text-main);
            margin: 0;
        }

        .content {
            padding: 50px;
            max-width: 1000px;
            margin: 0 auto;
        }

        /* HEADER */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 20px;
        }

        h1 { margin: 0; font-weight: 800; color: var(--text-main); }
        .back-btn { color: var(--text-muted); text-decoration: none; font-weight: 600; }
        .back-btn:hover { color: var(--neon-green); }

        /* CARD STYLE */
        .card {
            background: var(--card-bg);
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            border: 1px solid var(--border-color);
            margin-bottom: 30px;
        }

        h3 { 
            margin-top: 0; 
            color: var(--text-main); 
            border-bottom: 2px solid var(--neon-green); 
            padding-bottom: 10px; 
            display: inline-block;
            font-size: 1.2rem;
        }

        .row {
            display: flex;
            margin-bottom: 15px;
            border-bottom: 1px solid #222;
            padding-bottom: 10px;
        }
        .row:last-child { border-bottom: none; }

        .label { width: 180px; color: var(--text-muted); font-weight: 600; }
        .value { color: #fff; font-family: 'JetBrains Mono', monospace; }

        /* TABEL KEY */
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 15px; border-bottom: 1px solid var(--border-color); text-align: left; }
        
        th { 
            background-color: #000; 
            color: var(--text-muted); 
            text-transform: uppercase; 
            font-size: 0.8rem; 
            font-weight: 700;
        }

        .key-code {
            font-family: 'JetBrains Mono', monospace;
            background: #222;
            padding: 5px 10px;
            border-radius: 6px;
            color: var(--neon-green);
            border: 1px solid #333;
            font-size: 0.9rem;
        }

        /* BADGES */
        .badge { padding: 5px 12px; border-radius: 50px; font-size: 0.75rem; font-weight: 800; }
        .badge-active { background: rgba(40, 167, 69, 0.2); color: #28a745; border: 1px solid #28a745; }
        .badge-inactive { background: rgba(220, 53, 69, 0.2); color: #dc3545; border: 1px solid #dc3545; }

        /* BUTTON TOGGLE */
        .btn-toggle {
            text-decoration: none; padding: 6px 15px; border-radius: 6px;
            font-size: 0.8rem; font-weight: 700; display: inline-block; transition: 0.3s;
        }
        .bg-red { background: transparent; border: 1px solid #dc3545; color: #dc3545; }
        .bg-green { background: transparent; border: 1px solid #28a745; color: #28a745; }
        
        .bg-red:hover { background: #dc3545; color: #fff; }
        .bg-green:hover { background: #28a745; color: #fff; }

        @media (max-width: 768px) {
            .content { padding: 20px; }
            .row { flex-direction: column; gap: 5px; }
            table { display: block; overflow-x: auto; }
        }
    </style>
</head>
<body>

    <%- include('../partials/navbar') %>

    <div class="content">
        <div class="page-header">
            <h1>🔍 Detail & History User</h1>
            <a href="/admin/users" class="back-btn">← Kembali ke Daftar</a>
        </div>

        <div class="card">
            <h3>👤 Data Personal</h3>
            
            <div class="row">
                <span class="label">Nama Lengkap</span>
                <span class="value">: <%= user.nama_lengkap %></span>
            </div>
            <div class="row">
                <span class="label">Email Login</span>
                <span class="value">: <%= user.email %></span>
            </div>
            <div class="row">
                <span class="label">Password</span>
                <span class="value">: <%= user.password %></span>
            </div>
            <div class="row">
                <span class="label">Bergabung Sejak</span>
                <span class="value">: <%= new Date(user.created_at).toLocaleString() %></span>
            </div>
        </div>

        <div class="card">
            <h3>Riwayat API Key</h3>
            
            <table>
                <thead>
                    <tr>
                        <th>Waktu Dibuat</th>
                        <th>API Key String</th>
                        <th>Status</th>
                        <th>Kontrol Admin</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(keys.length === 0) { %>
                        <tr><td colspan="4" style="text-align:center; padding:30px; color:#666;">User ini belum pernah generate API Key.</td></tr>
                    <% } %>

                    <% keys.forEach(k => { %>
                    <tr>
                        <td style="color:#ccc;"><%= new Date(k.created_at).toLocaleString() %></td>
                        <td><span class="key-code"><%= k.key_string %></span></td>
                        <td>
                            <% if(k.status == 'active') { %>
                                <span class="badge badge-active">AKTIF</span>
                            <% } else { %>
                                <span class="badge badge-inactive">NON-AKTIF</span>
                            <% } %>
                        </td>
                        <td>
                            <% if(k.status == 'active') { %>
                                <a href="/admin/keys/toggle/<%= k.id %>/<%= user.id %>" class="btn-toggle bg-red">Matikan Key</a>
                            <% } else { %>
                                <a href="/admin/keys/toggle/<%= k.id %>/<%= user.id %>" class="btn-toggle bg-green">Aktifkan Key</a>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

</body>
</html>
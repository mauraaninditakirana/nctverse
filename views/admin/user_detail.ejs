<!DOCTYPE html>
<html>
<head>
    <title>Detail User</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background: #f4f4f4; padding: 40px; }
        .card { background: white; max-width: 600px; margin: 0 auto; padding: 30px; border-radius: 10px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        h2 { border-bottom: 2px solid #ccff00; padding-bottom: 10px; }
        .row { margin-bottom: 15px; border-bottom: 1px solid #eee; padding-bottom: 10px; }
        .label { font-weight: bold; display: block; color: #555; }
        .api-box { background: #000; color: #ccff00; padding: 10px; font-family: monospace; border-radius: 5px; margin-top: 5px; word-break: break-all;}
        .btn-toggle { display: block; width: 100%; text-align: center; padding: 15px; text-decoration: none; color: white; font-weight: bold; border-radius: 5px; margin-top: 20px;}
        .bg-red { background: #dc3545; }
        .bg-green { background: #28a745; }
    </style>
</head>
<body>
    <div class="card">
        <a href="/admin/users" style="text-decoration:none;">← Kembali</a>
        <h2>👤 Detail Pengguna</h2>

        <div class="row"><span class="label">Nama:</span> <%= user.nama_lengkap %></div>
        <div class="row"><span class="label">Email:</span> <%= user.email %></div>
        <div class="row"><span class="label">Password:</span> <%= user.password %></div>
        <div class="row"><span class="label">Bergabung:</span> <%= user.created_at %></div>

        <div class="row" style="border:none;">
            <span class="label">🔑 API KEY:</span>
            <div class="api-box"><%= user.api_key || 'BELUM GENERATE' %></div>
        </div>

        <hr>
        <p style="text-align:center;">Status Akun: <strong><%= user.status.toUpperCase() %></strong></p>

        <% if (user.status == 'active') { %>
            <a href="/admin/users/toggle/<%= user.id %>/active" class="btn-toggle bg-red">⛔ NON-AKTIFKAN USER INI</a>
        <% } else { %>
            <a href="/admin/users/toggle/<%= user.id %>/inactive" class="btn-toggle bg-green">✅ AKTIFKAN KEMBALI</a>
        <% } %>
    </div>
</body>
</html>
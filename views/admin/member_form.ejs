<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tambah Member Baru</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --neon-green: #ccff00;
            --dark-bg: #0a0a0a;
            --card-bg: #161616;
            --text-main: #ffffff;
            --text-muted: #888888;
            --border-color: #333;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--dark-bg);
            color: var(--text-main);
            /* Hapus padding body agar container bisa full vertikal jika perlu */
            padding: 0; 
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh; /* Paksa tinggi setinggi layar */
            margin: 0;
            overflow: hidden; /* Hilangkan scrollbar body */
        }

        .form-container {
            background: var(--card-bg);
            max-width: 950px; /* Sedikit lebih lebar supaya input tidak turun */
            width: 95%;
            padding: 25px; /* Padding lebih kecil */
            border-radius: 16px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            border: 1px solid var(--border-color);
            box-sizing: border-box;
        }

        h2 { 
            margin: 0 0 15px 0; /* Margin judul diperkecil */
            color: var(--text-main); 
            font-weight: 800; 
            text-align: center; 
            font-size: 1.3rem; /* Font judul diperkecil */
        }
        
        /* Grid 2 Kolom */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr; 
            gap: 20px;
        }

        .form-group { margin-bottom: 8px; /* Jarak antar input DIPERAPAT */ }
        
        label { 
            display: block; 
            margin-bottom: 3px; 
            font-weight: 600; 
            color: var(--text-muted); 
            font-size: 0.8rem; /* Font label diperkecil */
        }
        
        input, textarea, select {
            width: 100%; 
            padding: 8px 10px; /* Padding input lebih tipis */
            border: 1px solid var(--border-color); 
            border-radius: 6px; 
            box-sizing: border-box;
            background: #000;
            color: #fff;
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem; /* Font input diperkecil */
            transition: 0.3s;
        }

        /* Fix Kalender */
        input[type="date"] { color-scheme: dark; }
        input[type="date"]::-webkit-calendar-picker-indicator { filter: invert(1); cursor: pointer; transform: scale(0.8); }

        input:focus, textarea:focus { border-color: var(--neon-green); outline: none; }

        /* Checkbox Group - Dibuat Scrollable kecil jika unitnya banyak */
        .checkbox-group { 
            display: grid; 
            grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
            gap: 6px; 
            margin-top: 2px;
            max-height: 80px; /* Batasi tinggi area unit */
            overflow-y: auto; /* Scroll jika unit sangat banyak */
        }
        
        .checkbox-item {
            background: #222; padding: 4px 8px; border-radius: 4px;
            font-size: 0.75rem; cursor: pointer; border: 1px solid var(--border-color);
            display: flex; align-items: center; gap: 5px; color: #ccc;
        }
        
        .checkbox-item:hover { background: #333; border-color: var(--neon-green); }
        input[type="checkbox"] { width: auto; margin: 0; accent-color: var(--neon-green); }

        .full-width { 
            grid-column: span 2; 
            display: flex; 
            gap: 10px; 
            margin-top: 10px; /* Jarak tombol ke atas */
        }

        button {
            background: var(--neon-green); color: #000; border: none; 
            padding: 10px; /* Tombol lebih tipis */
            font-weight: 800; cursor: pointer; border-radius: 8px; flex: 2;
            font-size: 0.9rem; text-transform: uppercase; transition: 0.3s;
        }
        button:hover { background: #fff; transform: translateY(-2px); }

        .back-btn { 
            display: block; text-align: center; 
            background: #222; color: #fff; text-decoration: none; 
            padding: 10px; border-radius: 8px; flex: 1;
            font-size: 0.9rem; font-weight: 600; border: 1px solid #333;
        }
        .back-btn:hover { border-color: var(--text-muted); }

    </style>
</head>
<body>

    <div class="form-container">
        <h2>➕ Tambah Member Baru</h2>
        
        <form action="/admin/members/add" method="POST" class="form-grid">
            
            <div class="left-col">
                <div class="form-group">
                    <label>Nama Panggung</label>
                    <input type="text" name="nama_panggung" required placeholder="Contoh: Haechan">
                </div>
                
                <div class="form-group">
                    <label>Nama Lengkap</label>
                    <input type="text" name="nama_lengkap" required placeholder="Nama Asli...">
                </div>

                <div class="form-group">
                    <label>Tanggal Lahir</label>
                    <input type="date" name="tgl_lahir" required>
                </div>

                <div class="form-group">
                    <label>Asal Negara</label>
                    <input type="text" name="asal_negara" required placeholder="Contoh: Korea Selatan">
                </div>

                <div class="form-group">
                    <label>Posisi</label>
                    <input type="text" name="posisi" placeholder="Contoh: Main Vocal">
                </div>
            </div>

            <div class="right-col">
                <div class="form-group">
                    <label>Nama File Foto</label>
                    <input type="text" name="foto" value="default.jpg">
                    <small style="color:#666; font-size:0.65rem;">*File harus ada di public/images</small>
                </div>

                <div class="form-group">
                    <label>Biografi Singkat</label>
                    <textarea name="biografi" rows="3" placeholder="Deskripsi member..."></textarea>
                </div>

                <div class="form-group">
                    <label>Unit (Pilih Unit):</label>
                    <div class="checkbox-group">
                        <% units.forEach(u => { %>
                            <label class="checkbox-item">
                                <input type="checkbox" name="units" value="<%= u.id %>"> 
                                <%= u.nama_unit %>
                            </label>
                        <% }) %>
                    </div>
                </div>
            </div>

            <div class="full-width">
                <a href="/admin/members" class="back-btn">Batal</a>
                <button type="submit">SIMPAN DATA</button>
            </div>

        </form>
    </div>

</body>
</html>
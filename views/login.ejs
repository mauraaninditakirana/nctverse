<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Administrator - NCTverse</title>
    <style>
        body {
            background-color: #050505;
            color: #e6e6e6;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .login-box {
            background: #111;
            padding: 40px;
            border-radius: 15px;
            border: 1px solid #333;
            text-align: center;
            width: 300px;
            box-shadow: 0 0 30px rgba(204, 255, 0, 0.1);
        }
        h2 { color: #ccff00; margin-bottom: 30px; text-transform: uppercase; }
        
        input {
            width: 100%; padding: 12px; margin-bottom: 15px;
            background: #222; border: 1px solid #444; color: white;
            border-radius: 5px; box-sizing: border-box;
        }
        input:focus { outline: none; border-color: #ccff00; }
        
        button {
            width: 100%; padding: 12px; background: #ccff00;
            color: black; font-weight: bold; border: none;
            border-radius: 5px; cursor: pointer; margin-top: 10px;
        }
        button:hover { background: #b3e600; }
        
        .error-msg { color: red; margin-bottom: 15px; font-size: 0.9rem; }
        .back { display: block; margin-top: 20px; color: #666; text-decoration: none; font-size: 0.8rem; }
    </style>
</head>
<body>

    <div class="login-box">
        <h2>🔐 Admin Area</h2>
        
        <% if (error) { %>
            <div class="error-msg"><%= error %></div>
        <% } %>

        <form action="/login" method="POST">
            <input type="text" name="username" placeholder="Username" required autocomplete="off">
            <input type="password" name="password" placeholder="Password" required>
            <button type="submit">MASUK SYSTEM</button>
        </form>

        <a href="/" class="back">← Kembali ke Website Utama</a>
    </div>

</body>
</html>
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NCTverse - Open Data</title>
    <style>
        /* CSS Langsung disini biar praktis */
        body {
            background-color: #050505;
            color: #e6e6e6;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            text-align: center;
        }
        .header {
            padding: 50px 20px;
            background: linear-gradient(180deg, #1a1a1a 0%, #050505 100%);
        }
        h1 {
            color: #ccff00; /* Warna Hijau Neon NCT */
            font-size: 3.5rem;
            margin: 0;
            letter-spacing: 3px;
            text-transform: uppercase;
            text-shadow: 0 0 15px rgba(204, 255, 0, 0.5);
        }
        p { font-size: 1.2rem; color: #888; margin-top: 10px; }
        
        /* Container Grid Unit */
        .container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 30px;
            padding: 50px 20px;
            max-width: 1200px;
            margin: 0 auto;
        }

        /* Kartu Unit - Padding disesuaikan jadi 20px biar lebih pas */
        .card {
            background: #111;
            border: 1px solid #333;
            border-radius: 15px;
            width: 280px;
            padding: 20px; 
            text-decoration: none;
            color: white;
            transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .card:hover {
            transform: translateY(-10px);
            border-color: #ccff00;
            box-shadow: 0 0 25px rgba(204, 255, 0, 0.2);
            cursor: pointer;
        }

        .unit-icon {
            font-size: 4rem;
            margin-bottom: 15px;
        }

        .unit-name {
            font-size: 1.8rem;
            font-weight: bold;
            color: #fff;
            margin-bottom: 5px; /* Jarak bawah dikurangi karena deskripsi hilang */
        }

        /* Class .unit-desc SUDAH DIHAPUS dari CSS ini */

        .footer {
            margin-top: 50px;
            padding: 20px;
            font-size: 0.8rem;
            color: #444;
            border-top: 1px solid #111;
        }
    </style>
</head>
<body>

    <div class="header">
        <h1>NCTVERSE</h1>
        <p>The Neo Culture Technology Open Database</p>
    </div>

    <div class="container">
        <% units.forEach(unit => { %>
            <a href="/unit/<%= unit.id %>" class="card">
                <div class="unit-icon">
                    <% if(unit.nama_unit.includes('127')) { %> 🏙️ 
                    <% } else if(unit.nama_unit.includes('DREAM')) { %> 🎢 
                    <% } else if(unit.nama_unit.includes('WayV')) { %> 🐉 
                    <% } else if(unit.nama_unit.includes('WISH')) { %> 🧚‍♂️ 
                    <% } else { %> 💚 <% } %>
                </div>
                
                <div class="unit-name"><%= unit.nama_unit %></div>
            </a>
        <% }); %>
    </div>

    <div class="footer">
        &copy; 2026 NCTverse System. Built with Node.js & MySQL.
    </div>

</body>
</html>
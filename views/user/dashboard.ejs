<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Developer - NCT API</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --neon-green: #ccff00;
            --dark-bg: #0a0a0a;
            --card-bg: #161616;
            --border-color: #333;
            --text-main: #ffffff;
            --text-muted: #888888;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--dark-bg);
            color: var(--text-main);
            margin: 0;
            padding: 40px 20px;
            background-image: radial-gradient(circle at 10% 20%, rgba(204, 255, 0, 0.03) 0%, transparent 20%);
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            background: var(--card-bg);
            padding: 50px;
            border-radius: 24px;
            border: 1px solid var(--border-color);
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }

        /* --- HEADER AREA --- */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
        }

        h2 { 
            margin: 0; 
            font-weight: 800; 
            font-size: 2rem; 
            letter-spacing: -1px;
            background: linear-gradient(90deg, #fff, #999);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .sub-text { 
            color: var(--text-muted); 
            font-size: 1rem; 
            margin-top: 5px;
        }
        .sub-text strong { color: var(--neon-green); }

        .btn-logout {
            color: #ff4d4d;
            text-decoration: none;
            font-weight: 600;
            border: 1px solid #ff4d4d;
            padding: 10px 25px;
            border-radius: 100px;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }
        .btn-logout:hover { 
            background: #ff4d4d; 
            color: white; 
            box-shadow: 0 0 15px rgba(255, 77, 77, 0.4);
        }

        /* --- API KEY SECTION --- */
        .key-section {
            background: rgba(255, 255, 255, 0.02);
            border: 1px dashed var(--border-color);
            padding: 40px;
            border-radius: 16px;
            text-align: center;
            margin-bottom: 40px;
            transition: 0.3s;
        }
        .key-section:hover { border-color: #555; background: rgba(255, 255, 255, 0.04); }

        .key-section h3 { margin-top: 0; font-weight: 600; color: #ddd; }

        .key-box {
            background: #000;
            color: var(--neon-green);
            padding: 20px;
            font-family: 'JetBrains Mono', monospace; /* Font coding */
            font-size: 1.2rem;
            font-weight: bold;
            border-radius: 12px;
            margin: 20px auto;
            border: 1px solid #333;
            word-break: break-all;
            max-width: 80%;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
        }

        .status-active { 
            color: var(--dark-bg); 
            background: var(--neon-green);
            padding: 4px 10px;
            border-radius: 4px;
            font-weight: bold;
            font-size: 0.8rem;
            text-transform: uppercase;
        }
        .status-inactive { color: #ff4d4d; font-weight: bold; }

        .btn-gen {
            background: var(--neon-green);
            color: #000;
            font-weight: 800;
            border: none;
            padding: 14px 40px;
            border-radius: 50px;
            cursor: pointer;
            font-size: 1rem;
            transition: all 0.3s ease;
            margin-top: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .btn-gen:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 0 25px rgba(204, 255, 0, 0.4); 
        }

        /* --- TESTING AREA --- */
        .test-area {
            background: #0f0f0f;
            padding: 30px;
            border-radius: 16px;
            border: 1px solid var(--border-color);
        }
        
        .test-area h3 { color: #fff; margin-bottom: 5px; }

        .input-group {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }

        input[type="text"] {
            flex: 1;
            padding: 15px 20px;
            font-size: 1rem;
            background: #000;
            border: 1px solid #333;
            color: #fff;
            border-radius: 12px;
            outline: none;
            font-family: 'JetBrains Mono', monospace;
            transition: 0.3s;
        }
        input[type="text"]:focus { 
            border-color: var(--neon-green); 
            box-shadow: 0 0 0 2px rgba(204, 255, 0, 0.1);
        }

        .btn-test {
            background: #fff;
            color: #000;
            border: none;
            padding: 0 30px;
            font-weight: 800;
            border-radius: 12px;
            cursor: pointer;
            transition: 0.3s;
        }
        .btn-test:hover { background: var(--neon-green); }

        /* --- RESULT GRID (KARTU VISUAL) --- */
        .result-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .mini-card {
            background: #111;
            border-radius: 16px;
            overflow: hidden;
            text-align: center;
            border: 1px solid #333;
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .mini-card:hover {
            transform: translateY(-5px);
            border-color: var(--neon-green);
            box-shadow: 0 10px 30px rgba(204, 255, 0, 0.15);
        }

        .card-img {
            width: 100%;
            height: 250px; /* TINGGI FOTO DISAMAKAN */
            object-fit: cover; /* Agar foto tidak gepeng */
            border-bottom: 2px solid #333;
            transition: 0.3s;
        }
        
        .mini-card:hover .card-img { border-bottom-color: var(--neon-green); }

        .card-body { padding: 15px; flex-grow: 1; display: flex; flex-direction: column; justify-content: center; }
        
        .mini-card h4 { margin: 5px 0; color: #fff; font-size: 1.1rem; }
        .mini-card p { margin: 0; color: #888; font-size: 0.85rem; }
        
        .badge-id {
            position: absolute; top: 10px; right: 10px;
            background: var(--neon-green); color: #000;
            padding: 4px 10px; border-radius: 6px;
            font-size: 0.75rem; font-weight: bold;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }

        /* --- MODAL POPUP (TETAP SAMA TAPI RAPID) --- */
        .modal-overlay {
            display: none;
            position: fixed; top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.9);
            z-index: 999;
            justify-content: center; align-items: center;
            backdrop-filter: blur(8px);
        }

        .modal-content {
            background: #111;
            color: white;
            width: 90%; max-width: 800px; /* Landscape mode */
            padding: 40px;
            border-radius: 24px;
            border: 1px solid #333;
            box-shadow: 0 0 50px rgba(204, 255, 0, 0.1);
            position: relative;
            animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes slideUp { from {transform: translateY(50px); opacity: 0;} to {transform: translateY(0); opacity: 1;} }

        .close-btn {
            position: absolute; top: 20px; right: 25px;
            font-size: 2rem; color: #666; cursor: pointer; transition: 0.2s;
        }
        .close-btn:hover { color: var(--neon-green); }

        .modal-layout { display: flex; gap: 40px; text-align: left; }
        .modal-left { flex: 0 0 250px; text-align: center; border-right: 1px solid #333; padding-right: 30px; }
        .modal-right { flex: 1; }

        .modal-img {
            width: 200px; height: 200px; border-radius: 50%; object-fit: cover;
            border: 3px solid var(--neon-green); margin-bottom: 20px;
            box-shadow: 0 0 30px rgba(204, 255, 0, 0.2);
        }

        .unit-badge {
            background: #222; color: var(--neon-green);
            padding: 8px 16px; border-radius: 50px; font-size: 0.85rem;
            border: 1px solid var(--neon-green); display: inline-block;
            font-weight: 700; margin-top: 15px; letter-spacing: 0.5px;
        }

        .detail-row {
            display: flex; justify-content: space-between;
            border-bottom: 1px solid #222; padding: 12px 0;
        }
        .detail-label { color: #666; font-weight: 600; }
        .detail-value { color: #fff; font-family: 'JetBrains Mono', monospace; }

        /* BIOGRAFI SCROLLABLE */
        .bio-box {
            background: #1a1a1a; padding: 20px; border-radius: 12px;
            font-size: 0.95rem; line-height: 1.6; margin-top: 20px; color: #ccc;
            border: 1px solid #333;
            max-height: 150px; /* Batasi tinggi maksimal */
            overflow-y: auto; /* Munculkan scroll jika teks kepanjangan */
        }
        
        /* Custom Scrollbar untuk Bio */
        .bio-box::-webkit-scrollbar { width: 8px; }
        .bio-box::-webkit-scrollbar-track { background: #111; border-radius: 10px; }
        .bio-box::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }
        .bio-box::-webkit-scrollbar-thumb:hover { background: var(--neon-green); }

        .btn-download {
            display: block; margin-top: 25px; padding: 15px;
            background: var(--neon-green); color: #000; text-decoration: none;
            font-weight: 800; border-radius: 12px; text-align: center;
            text-transform: uppercase; letter-spacing: 1px; transition: 0.3s;
        }
        .btn-download:hover { 
            background: #fff; 
            box-shadow: 0 0 20px rgba(204, 255, 0, 0.6); 
        }

        /* Mobile Responsive */
        @media (max-width: 768px) {
            .modal-layout { flex-direction: column; text-align: center; }
            .modal-left { border-right: none; border-bottom: 1px solid #333; padding-right: 0; padding-bottom: 30px; margin-bottom: 20px; }
            .container { padding: 20px; }
            .input-group { flex-direction: column; }
            .btn-test { width: 100%; padding: 15px; }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="header">
            <div>
                <h2>Halo, NCTzen!</h2>
                <div class="sub-text">Selamat Datangg! <strong><%= user.nama_lengkap %></strong></div>
            </div>
            <a href="/developer/logout" class="btn-logout">Logout</a>
        </div>

        <div class="key-section">
            <h3>API Key saat ini</h3>
            
            <% if (user.api_key) { %>
                <div class="key-box"><%= user.api_key %></div>
                <p style="color:#888; font-size:0.9rem; margin-top:10px;">
                    Status: 
                    <% if(user.status == 'active') { %>
                        <span class="status-active">AKTIF</span>
                    <% } else { %>
                        <span class="status-inactive">NON-AKTIF</span>
                    <% } %>
                </p>
                <p style="color:#555; font-size:0.85rem; margin-bottom:20px;">Pastikan API Key mu aktif ya!!</p>
            <% } else { %>
                <p style="color:#888;">Anda belum memiliki API Key.</p>
            <% } %>

            <form action="/developer/generate-key" method="POST">
                <button type="submit" class="btn-gen">
                     <%= user.api_key ? 'Reset Key' : 'Generate API Key' %>
                </button>
            </form>
        </div>

        <div class="test-area">
            <h3>API ZONE</h3>
            <p style="color:#666; font-size:0.9rem;">Tempel API Key di bawah untuk melihat data.</p>
            
            <div class="input-group">
                <input type="text" id="inputKey" placeholder="Paste your API Key here..." value="">
                <button onclick="testApi()" class="btn-test">LIHAT DATA</button>
            </div>

            <div id="resultContainer"></div>
        </div>
    </div>

    <div id="detailModal" class="modal-overlay">
        <div class="modal-content">
            <span class="close-btn" onclick="closeModal()">&times;</span>
            
            <div class="modal-layout">
                <div class="modal-left">
                    <img id="mFoto" src="" class="modal-img" alt="Foto Member">
                    <h2 id="mNama" style="margin:0; color:var(--neon-green); font-size:2rem; line-height:1;">Nama</h2>
                    <h4 id="mNamaLengkap" style="margin:8px 0 0 0; color:#fff; font-weight:normal;">Nama Lengkap</h4>
                    <p id="mPosisi" style="color:#888; margin-top:5px; font-style:italic;">Posisi</p>
                    <span id="mUnit" class="unit-badge">Unit Name</span>
                </div>

                <div class="modal-right">
                    <div>
                        <div class="detail-row">
                            <span class="detail-label">ID Database</span>
                            <span id="mId" class="detail-value" style="color:var(--neon-green);"></span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Asal Negara</span>
                            <span id="mAsal" class="detail-value"></span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Tanggal Lahir</span>
                            <span id="mTgl" class="detail-value"></span>
                        </div>

                        <div style="margin-top:20px; font-weight:bold; color:var(--neon-green); font-size:0.9rem;">BIOGRAFI SINGKAT</div>
                        <div id="mBio" class="bio-box"></div>
                    </div>

                    <a id="btnDownload" href="#" class="btn-download">
                        ⬇️ Download Data (.TXT)
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        // 1. Fungsi Tarik Data dari API
        async function testApi() {
            const key = document.getElementById('inputKey').value;
            const container = document.getElementById('resultContainer');
            
            if(!key) {
                alert("Harap masukkan API Key terlebih dahulu!");
                return;
            }

            container.innerHTML = '<p style="text-align:center; margin-top:30px; font-weight:bold; color:#666;">⏳ Fetching data...</p>';

            try {
                const response = await fetch(`/api/v1/members?key=${key}`);
                const data = await response.json();

                if(data.status === 'error') {
                    container.innerHTML = `
                        <div style="background:rgba(255, 77, 77, 0.1); color:#ff4d4d; padding:15px; border-radius:12px; margin-top:20px; border:1px solid #ff4d4d; text-align:center;">
                             <strong>AKSES DITOLAK:</strong> ${data.message}
                        </div>
                    `;
                } else {
                    let htmlContent = `
                        <div style="margin-top:20px; text-align:center; color:var(--neon-green); font-family:'JetBrains Mono'; font-size:0.9rem;">
                            > Status: 200 OK | Total: ${data.total_data} Members loaded.
                        </div>
                        <div class="result-grid">
                    `;

                    data.data.forEach(member => {
                        let fotoUrl = member.foto ? `/images/${member.foto}` : 'https://via.placeholder.com/300x350?text=No+Image';
                        let memberString = JSON.stringify(member).replace(/"/g, '&quot;');

                        htmlContent += `
                            <div class="mini-card" onclick="openModal(${memberString})">
                                <span class="badge-id">#${member.id}</span>
                                <img src="${fotoUrl}" class="card-img" alt="${member.nama_panggung}">
                                <div class="card-body">
                                    <h4>${member.nama_panggung}</h4>
                                    <p>${member.posisi}</p>
                                    <small style="display:block; margin-top:10px; color:var(--neon-green); opacity:0.7;">Click for Details ↗</small>
                                </div>
                            </div>
                        `;
                    });

                    htmlContent += `</div>`;
                    container.innerHTML = htmlContent;
                }

            } catch (error) {
                container.innerHTML = `<p style="color:#ff4d4d; text-align:center;">Server Error / Offline.</p>`;
            }
        }

        // 2. Fungsi Buka Modal Detail (Logic Tetap Sama)
        function openModal(member) {
            const key = document.getElementById('inputKey').value;

            document.getElementById('mFoto').src = member.foto ? `/images/${member.foto}` : 'https://via.placeholder.com/300';
            document.getElementById('mNama').innerText = member.nama_panggung;
            document.getElementById('mNamaLengkap').innerText = member.nama_lengkap || '-';
            document.getElementById('mPosisi').innerText = member.posisi;
            document.getElementById('mUnit').innerText = member.unit_names || 'No Unit';

            document.getElementById('mId').innerText = member.id;
            document.getElementById('mAsal').innerText = member.asal_negara;
            document.getElementById('mTgl').innerText = member.tgl_lahir ? new Date(member.tgl_lahir).toLocaleDateString() : '-';
            document.getElementById('mBio').innerText = member.biografi || "Tidak ada data biografi.";

            const downloadUrl = `/api/v1/download/member/${member.id}?key=${key}`;
            document.getElementById('btnDownload').href = downloadUrl;

            document.getElementById('detailModal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('detailModal').style.display = 'none';
        }

        window.onclick = function(event) {
            const modal = document.getElementById('detailModal');
            if (event.target == modal) {
                modal.style.display = "none";
            }
        }
    </script>

</body>
</html>
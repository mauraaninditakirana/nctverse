<style>
    /* --- FIX 1: STABILITAS LAYOUT --- */
    html {
        overflow-y: scroll; /* Scrollbar selalu muncul agar layout tidak 'lompat' kiri-kanan */
    }

    /* Styling Navbar Container */
    .admin-navbar {
        background-color: #161616;
        border-bottom: 1px solid #333;
        padding: 15px 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 1000;
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }

    /* Logo / Brand */
    .nav-brand {
        font-weight: 800;
        font-size: 1.4rem;
        color: #ccff00;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        line-height: 1;
    }
    .nav-brand small {
        font-size: 0.65rem;
        color: #fff;
        letter-spacing: 2px;
        margin-top: 3px;
    }

    /* Menu Wrapper */
    .nav-menu {
        display: flex;
        gap: 15px;
        background: #0a0a0a;
        padding: 5px 10px;
        border-radius: 50px;
        border: 1px solid #333;
    }

    /* Menu Items */
    .nav-item {
        color: #888;
        text-decoration: none;
        font-weight: 600; /* Ketebalan Tetap */
        font-size: 0.9rem;
        padding: 8px 20px;
        border-radius: 50px;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
        /* FIX 2: Set lebar minimum agar tidak goyang saat hover (Opsional, tapi bagus) */
        min-width: 100px; 
        justify-content: center;
    }

    .nav-item:hover {
        color: #fff;
        background-color: rgba(255, 255, 255, 0.1);
    }

    /* Active State */
    .nav-item.active {
        background-color: #ccff00;
        color: #000;
        /* font-weight: 700;  <-- DIHAPUS SUPAYA UKURAN TIDAK BERUBAH */
        font-weight: 600;  /* Tetap sama dengan state normal */
        box-shadow: 0 0 15px rgba(204, 255, 0, 0.3);
    }

    /* Tombol Logout */
    .nav-logout {
        width: 45px;
        height: 45px;
        background-color: #1a1a1a;
        color: #ff4d4d;
        border: 1px solid #ff4d4d;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 1.2rem;
        transition: all 0.3s ease;
        position: relative;
    }

    .nav-logout:hover {
        background-color: #ff4d4d;
        color: white;
        transform: rotate(90deg);
        box-shadow: 0 0 15px rgba(255, 77, 77, 0.5);
    }

    @media (max-width: 900px) {
        .admin-navbar { flex-wrap: wrap; padding: 15px 20px; gap: 15px; }
        .nav-menu { order: 3; width: 100%; justify-content: center; overflow-x: auto; }
        .nav-brand { order: 1; }
        .nav-logout { order: 2; }
    }
</style>

<nav class="admin-navbar">
    <a href="/admin" class="nav-brand">
        NCTVERSE
        <small>ADMIN PANEL</small>
    </a>

    <div class="nav-menu">
        <a href="/admin" class="nav-item <%= typeof page !== 'undefined' && page === 'dashboard' ? 'active' : '' %>">
            🏠 Dashboard
        </a>

        <a href="/admin/members" class="nav-item <%= typeof page !== 'undefined' && page === 'members' ? 'active' : '' %>">
            👤 Members
        </a>

        <a href="/admin/users" class="nav-item <%= typeof page !== 'undefined' && page === 'users' ? 'active' : '' %>">
            👥 User API
        </a>

        <a href="/admin/units" class="nav-item <%= typeof page !== 'undefined' && page === 'units' ? 'active' : '' %>">
            🏢 Units
        </a>

        <a href="/" target="_blank" class="nav-item" style="border-left: 1px solid #333; padding-left: 20px; margin-left: 5px;">
            🌍 Website
        </a>
    </div>

    <a href="/logout" class="nav-logout" title="Keluar">
        ⏻
    </a>
</nav>
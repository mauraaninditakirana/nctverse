<style>
    .sidebar {
        width: 250px;
        background-color: #050505;
        color: #fff;
        display: flex;
        flex-direction: column;
        padding-top: 20px;
        flex-shrink: 0; /* Mencegah sidebar mengecil */
        height: 100vh; /* Full tinggi layar */
        position: fixed; /* Supaya diam saat discroll */
        left: 0; top: 0;
    }

    .brand {
        text-align: center;
        margin-bottom: 30px;
        font-weight: bold;
        color: #ccff00;
        font-size: 1.5rem;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .menu-item {
        padding: 15px 25px;
        color: #ccc;
        text-decoration: none;
        display: flex;
        gap: 12px;
        align-items: center;
        transition: 0.3s;
        font-size: 0.95rem;
        border-left: 4px solid transparent;
    }

    .menu-item:hover {
        background-color: #1a1a1a;
        color: #fff;
    }

    /* KELAS ACTIVE (Otomatis menyala) */
    .menu-item.active {
        background-color: #111;
        color: #ccff00;
        border-left: 4px solid #ccff00;
        font-weight: bold;
    }

    .logout-btn {
        margin-top: auto; /* Dorong ke paling bawah */
        background-color: #d9534f;
        color: white;
        text-align: center;
        padding: 15px;
        text-decoration: none;
        font-weight: bold;
        border: none;
    }
    .logout-btn:hover { background-color: #c9302c; }
</style>

<div class="sidebar">
    <div class="brand">NCTVERSE<br><small style="font-size:0.7rem; color:white; letter-spacing:0;">Admin Panel</small></div>
    
    <a href="/admin" class="menu-item <%= page === 'dashboard' ? 'active' : '' %>">
        🏠 Dashboard
    </a>

    <a href="/admin/members" class="menu-item <%= page === 'members' ? 'active' : '' %>">
        👤 Kelola Members
    </a>

    <a href="/admin/users" class="menu-item <%= page === 'users' ? 'active' : '' %>">
        👥 Kelola User API
    </a>

    <a href="/admin/units" class="menu-item <%= page === 'units' ? 'active' : '' %>">
        🏢 Kelola Units
    </a>

    <a href="/" target="_blank" class="menu-item">
        🌍 Lihat Website
    </a>

    <a href="/logout" class="logout-btn">Logout</a>
</div>